{
  "name": "@local/dsh-sidebar-agent",
  "version": "0.4.0",
  "engines": { "dsh": ">=0.2.2-rc.1" },
  "scripts": {
    "build": "node build-client.mjs",
    "test": "node build-client.mjs --check && node --test *.test.js"
  },
  "private": true,
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "description": "Independent sidebar agents mounted under a main session, with the full DSH composer, automatic main-session context, a built-in selection toolbar, and isolated model and reasoning defaults.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "archive.js",
    "models.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/images/*.png",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liaosiqian/dsh-sidebar-agent.git"
  },
  "homepage": "https://github.com/liaosiqian/dsh-sidebar-agent#readme"
}
