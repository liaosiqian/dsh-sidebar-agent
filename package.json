{
  "name": "@local/dsh-sidebar-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Independent sidebar agents mounted under a main session, with the full DSH composer, automatic main-session context, and a built-in selection toolbar.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liaosiqian/dsh-sidebar-agent.git"
  },
  "homepage": "https://github.com/liaosiqian/dsh-sidebar-agent#readme"
}
